diff --git a/native/mod-loader/ep_roster.c b/native/mod-loader/ep_roster.c
new file mode 100644
index 0000000..31bcf12
--- /dev/null
+++ b/native/mod-loader/ep_roster.c
@@ -0,0 +1,136 @@
+/* GPL-3.0-only. Included after SafeRead, before events/passives/actions.
+ * The private provider's lifetime is protected by a shared reader lock: unbind
+ * waits for every callback, then forgets its context. Invalid snapshots never
+ * fall through to the game's fixed four-slot arrays. */
+#include "ep_roster.h"
+static SRWLOCK g_epRosterLock = SRWLOCK_INIT;
+static HfMod* g_epRosterOwner;
+static EpHfRosterProvider g_epRosterProvider;
+static uint64_t g_epRosterLease, g_epRosterNext;
+static _Thread_local int g_epRosterReading;
+
+static uint64_t EpRosterBind(HfMod* owner, const EpHfRosterProvider* provider)
+{
+    if (g_epRosterReading || !owner || !provider || strcmp(g_build, "25480438") ||
+        provider->size != sizeof *provider || provider->version != EP_HF_ROSTER_VERSION ||
+        !provider->read || !provider->context || !provider->capacity ||
+        provider->capacity > EP_HF_ROSTER_LIMIT || provider->reserved) return 0;
+    int known = 0;
+    for (int i = 0; i < g_modCount; i++) if (owner == &g_mods[i]) known = 1;
+    if (!known || !owner->loaded) return 0;
+    AcquireSRWLockExclusive(&g_epRosterLock);
+    uint64_t lease = 0;
+    if (!g_epRosterOwner && g_epRosterNext != UINT64_MAX)
+    {
+        g_epRosterOwner = owner;
+        g_epRosterProvider = *provider;
+        lease = g_epRosterLease = ++g_epRosterNext;
+    }
+    ReleaseSRWLockExclusive(&g_epRosterLock);
+    return lease;
+}
+
+static int EpRosterUnbind(HfMod* owner, uint64_t lease)
+{
+    if (g_epRosterReading || !owner || !lease) return 0;
+    AcquireSRWLockExclusive(&g_epRosterLock);
+    int ok = owner == g_epRosterOwner && lease == g_epRosterLease;
+    if (ok)
+    {
+        g_epRosterOwner = NULL;
+        g_epRosterLease = 0;
+        memset(&g_epRosterProvider, 0, sizeof g_epRosterProvider);
+    }
+    ReleaseSRWLockExclusive(&g_epRosterLock);
+    return ok;
+}
+
+/* A declined init must not leave a dead provider or block subsequent mods. */
+static void EpRosterDeclined(HfMod* owner)
+{
+    AcquireSRWLockExclusive(&g_epRosterLock);
+    if (g_epRosterOwner == owner)
+    {
+        g_epRosterOwner = NULL;
+        g_epRosterLease = 0;
+        memset(&g_epRosterProvider, 0, sizeof g_epRosterProvider);
+    }
+    ReleaseSRWLockExclusive(&g_epRosterLock);
+}
+
+__declspec(dllexport) const EpHfRosterApi* hellforge_ep_roster_api_v1(void)
+{
+    static const EpHfRosterApi api = {EP_HF_ROSTER_MAGIC, sizeof api, EP_HF_ROSTER_VERSION,
+                                    EP_HF_ROSTER_LIMIT, EpRosterBind, EpRosterUnbind};
+    return &api;
+}
+
+static int EpRosterValid(const EpHfRosterSnapshot* out, uint32_t capacity)
+{
+    if (out->size != sizeof *out || out->version != EP_HF_ROSTER_VERSION || !out->epoch || out->binding ||
+        out->capacity != capacity || out->count > capacity) return 0;
+    uint32_t locals = 0;
+    for (uint32_t i = 0; i < out->count; i++)
+    {
+        const EpHfPlayer* p = &out->players[i];
+        if (!p->peer || !p->generation || p->network_index >= capacity || p->local > 1 || p->reserved) return 0;
+        locals += p->local;
+        for (uint32_t j = 0; j < i; j++)
+        {
+            const EpHfPlayer* q = &out->players[j];
+            if (p->peer == q->peer || p->network_index == q->network_index ||
+                (p->player && p->player == q->player) || (p->avatar && p->avatar == q->avatar)) return 0;
+        }
+    }
+    return locals <= 1;
+}
+
+/* Reads only the reviewed four-slot layout. The raw count is checked BEFORE a
+ * record read, even though all loader-side buffers can now hold sixteen. */
+static int EpRosterVanilla(uintptr_t game, EpHfRosterSnapshot* out)
+{
+    uintptr_t manager = 0, user = 0;
+    uint32_t count = 0;
+    uint64_t local = 0;
+    if (!game || SafeRead(game + 0x3326468u, &manager, 8) || !manager ||
+        SafeRead(manager + 0x84, &count, 4) || count > 4) return -1;
+    if (!SafeRead(game + 0x347CEF0u, &user, 8) && user) SafeRead(user + 0xB398, &local, 8);
+    out->size = sizeof *out; out->version = EP_HF_ROSTER_VERSION; out->capacity = 4;
+    for (uint32_t i = 0; i < count; i++)
+    {
+        EpHfPlayer p = {0};
+        uintptr_t descriptor = 0;
+        if (SafeRead(manager + 0x2C8 + 0x38 * i, &p.peer, 8) ||
+            SafeRead(manager + 0x2E0 + 0x38 * i, &p.life, 4) ||
+            SafeRead(manager + 0xE8 + 8 * i, &descriptor, 8)) return -1;
+        if (descriptor && SafeRead(descriptor + 8, &p.player, 4)) return -1;
+        p.local = p.peer != 0 && p.peer == local; p.network_index = i;
+        p.network_id = 0x7FFF;
+        if (SafeRead(manager + 0x3A8 + 0x20 * i, &p.network_id, 4)) p.network_id = 0x7FFF;
+        out->players[out->count++] = p;
+    }
+    return (int)out->count;
+}
+
+/* Success count (including zero), -1 unavailable. Caller gets no partial data. */
+static int EpRosterRead(uintptr_t game, EpHfRosterSnapshot* out)
+{
+    memset(out, 0, sizeof *out);
+    if (g_epRosterReading) return -1;
+    EpHfRosterSnapshot next = {0};
+    next.size = sizeof next; next.version = EP_HF_ROSTER_VERSION;
+    AcquireSRWLockShared(&g_epRosterLock);
+    int count;
+    if (g_epRosterOwner)
+    {
+        g_epRosterReading = 1;
+        int ok = g_epRosterOwner->loaded ? g_epRosterProvider.read(g_epRosterProvider.context, game, &next) : 0;
+        g_epRosterReading = 0;
+        count = ok == 1 && EpRosterValid(&next, g_epRosterProvider.capacity) ? (int)next.count : -1;
+        next.binding = g_epRosterLease;
+    }
+    else count = EpRosterVanilla(game, &next);
+    if (count >= 0) *out = next;
+    ReleaseSRWLockShared(&g_epRosterLock);
+    return count;
+}
